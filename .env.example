# kobodash settings. `make setup` writes .env for you; or copy this file to .env and edit.
# Everything here is read by the server (Docker: `make serve`, or `make serve-local`).

# Shared secret the Kobo sends with every request. Anything long and random.
KOBODASH_TOKEN=change-me
# Signs over-the-air updates of the Kobo client. Never sent over the network; also stored on the Kobo.
# Empty = no updates are ever offered.
OTA_KEY=change-me-too

# Which folder of dashboards/ to show.
DASHBOARD=home
# How the Kobo reaches this server, no trailing slash: http://<this machine's LAN IP>:8737
PUBLIC_URL=http://192.168.1.50:8737
# Your time zone (IANA name).
TZ=Europe/London
# Where you are, for weather and air quality (Open-Meteo, no account needed).
LAT=51.5
LON=-0.12
# Air quality index: us (US AQI, default) or malaysia (DOE's Air Pollutant Index, nearest station).
AQI_INDEX=us
# Seconds between screen updates (a dashboard.json "refresh" overrides this).
REFRESH=180
# Screen size in pixels, WxH, and 0 = black-and-white screen, 1 = colour screen (templates see screen.color).
SCREEN=1072x1448
COLOR=0

# Anything else a dashboard.json uses as ${NAME}, for example:
# TODO_TOKEN=your-api-token

# --- optional ---------------------------------------------------------------
# Port to listen on (Docker: change the published port in docker-compose.yml too).
# PORT=8737
# Chromium binary. Default: chromium, chromium-browser, google-chrome-stable or google-chrome on PATH.
# CHROMIUM=/usr/bin/chromium
# For `make serve-local` only (Docker sets these itself; paths are relative to the repo):
# FONT_DIR=.cache/fonts
# DASHBOARDS_DIR=dashboards
# DEVICE_DIR=device/client
# The "host" source reads these (Docker mounts the host's /proc at /host/proc itself).
# HOST_PROC=/proc
# HWMON=/sys/class/hwmon
# The "unraid" source reads this file.
# DISKS_INI=/var/local/emhttp/disks.ini
